# local-memory 环境变量（v2）
MEMORY_DIR=~/.memory
MEMORY_RUNTIME=~/.memory/runtime
MEMORY_POOL=default

# Docker/HTTP 模式：客户端接入令牌（未设置拒绝以 HTTP 启动）
# MEMORY_HTTP_TOKEN=
# MEMORY_HTTP_PORT=8000

# embedder 覆盖（优先于池 config.json，容器部署免改配置文件）
# embedder = 把文字转成向量供语义检索的服务；bge-m3 是本项目固定使用的嵌入模型名
# BASE_URL 指向一个装了 bge-m3 的 Ollama
# MEMORY_EMBEDDER_BASE_URL=http://172.17.0.1:11434
# MEMORY_EMBEDDER_MODEL=bge-m3

# config_api.example.json 的 LLM 密钥（写入池目录 .env）
# NEWAPI_KEY=

# collection 由 pool.meta.json 的 chroma_collection 决定（默认 memories）
# MEMORY_CHROMA_COLLECTION=memories

MEMORY_USER_ID=default-user
MEMORY_VECTOR_REL_MARGIN=0.10
MEMORY_KW_REL_RATIO=0.25
